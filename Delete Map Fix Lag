local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local ProximityPromptService = game:GetService("ProximityPromptService")

-- 1. ÉP ĐỒ HOẠ ROBLOX VỀ MỨC THẤP NHẤT (LEVEL 1)
pcall(function()
    settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
end)

-- 2. XÓA SẠCH NƯỚC BIỂN TERRAIN (TẮT HOÀN TOÀN SÓNG BIỂN)
local Terrain = Workspace:FindFirstChildOfClass("Terrain")
if Terrain then
    pcall(function()
        Terrain:Clear() -- Xóa toàn bộ Nước Biển 3D, mất 100% sóng
        Terrain.WaterWaveSize = 0
        Terrain.WaterWaveSpeed = 0
    end)
end

-- 3. TẮT ÁNH SÁNG & BÓNG RÂM
Lighting.GlobalShadows = false
Lighting.FogEnd = 9e9
Lighting.Brightness = 1
Lighting.OutdoorAmbient = Color3.fromRGB(150, 150, 150)
Lighting.Ambient = Color3.fromRGB(150, 150, 150)

for _, v in ipairs(Lighting:GetChildren()) do
    if v:IsA("PostEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("Atmosphere") then
        pcall(function() v:Destroy() end)
    end
end

-- 4. TẠO SÀN MẶT BIỂN (ĐỘ CAO Y = 0)
local platform = Workspace:FindFirstChild("XDM_WaterPlatform")
if not platform then
    platform = Instance.new("Part")
    platform.Name = "XDM_WaterPlatform"
    platform.Size = Vector3.new(60000, 2, 60000)
    platform.Position = Vector3.new(0, -1, 0) -- Độ cao Y = 0
    platform.Anchored = true
    platform.CanCollide = true
    platform.Material = Enum.Material.SmoothPlastic
    platform.Transparency = 0.6
    platform.Color = Color3.fromRGB(40, 40, 40)
    platform.Parent = Workspace
end

-- 5. HÀM TÀNG HÌNH MAP & XÓA VFX (TỐI ƯU SIÊU NHẸ)
local function processFast(v)
    -- Nếu là NPC / Quái / Player -> Bỏ qua, giữ nguyên hiển thị
    local parent = v.Parent
    if parent then
        local pName = parent.Name
        if pName == "NPCs" or pName == "Enemies" or pName == "Characters" or parent:FindFirstChildOfClass("Humanoid") then
            if v:IsA("BasePart") then
                v.Transparency = 0
            end
            return
        end
    end

    -- Xóa ngay lập tức các hiệu ứng rác tốn RAM/FPS
    if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Highlight") or v:IsA("Explosion") or v:IsA("Decal") or v:IsA("Texture") or v:IsA("Light") then
        pcall(function() v:Destroy() end)
        return
    end

    -- Tàng hình các khối gạch Đảo/Nhà cửa
    if v:IsA("BasePart") or v:IsA("MeshPart") or v:IsA("UnionOperation") then
        if v ~= platform then
            pcall(function()
                v.Transparency = 1
                v.CastShadow = false
            end)
        end
    end
end

-- 6. TƯƠNG TÁC NPC MƯỢT 0 GIÂY (Không tốn CPU)
ProximityPromptService.PromptShown:Connect(function(prompt)
    pcall(function()
        prompt.Enabled = true
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = 60
    end)
end)

-- 7. CHẠY CHIA NHỎ ĐỢT VẬT THỂ (Mỗi lần 100 cái để điện thoại không bị giật)
task.spawn(function()
    local descendants = Workspace:GetDescendants()
    for i = 1, #descendants do
        processFast(descendants[i])
        if i % 100 == 0 then
            task.wait() -- Nhường CPU thở
        end
    end
end)

-- Quét vật thể mới sinh ra
Workspace.DescendantAdded:Connect(function(v)
    task.spawn(function()
        processFast(v)
    end)
end)
