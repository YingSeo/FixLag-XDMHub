-- ============================================================
-- SECTION 1: DETECT NPC - TRÁI TIM CỦA FIX NÀY
-- ============================================================
-- Một object là NPC nếu ancestor Model của nó có Humanoid
-- => KHÔNG BAO GIỜ đụng vào bất kỳ thứ gì bên trong NPC model

local npcCache = {} -- cache để không check lại nhiều lần

local function GetRootModel(obj)
    local cur = obj
    while cur.Parent and cur.Parent ~= Workspace do
        cur = cur.Parent
    end
    return cur
end

local function IsNPC(obj)
    -- Check từ cache trước
    local root = GetRootModel(obj)
    if not root then return false end

    local rootName = tostring(root)
    if npcCache[rootName] ~= nil then
        return npcCache[rootName]
    end

    -- Check có Humanoid không
    local hasHumanoid = root:FindFirstChildOfClass("Humanoid") ~= nil
        or root:FindFirstChildWhichIsA("Humanoid", true) ~= nil

    npcCache[rootName] = hasHumanoid
    return hasHumanoid
end

-- Check player character
local function IsPlayerPart(obj)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and obj:IsDescendantOf(p.Character) then
            return true
        end
    end
    return false
end

