local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local LocalPlayer = Players.LocalPlayer

local function createUI()
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "XDM_FixLag_UI"
    ScreenGui.ResetOnSpawn = false
    
    local success = pcall(function()
        ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end)
    if not success then
        ScreenGui.Parent = game:GetService("CoreGui")
    end

    local FpsLabel = Instance.new("TextLabel")
    FpsLabel.Name = "FpsLabel"
    FpsLabel.Parent = ScreenGui
    FpsLabel.Size = UDim2.new(0, 140, 0, 30)
    FpsLabel.Position = UDim2.new(0, 15, 0, 15)
    FpsLabel.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    FpsLabel.BackgroundTransparency = 0.2
    FpsLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
    FpsLabel.TextSize = 15
    FpsLabel.Font = Enum.Font.SourceSansBold
    FpsLabel.Text = "FPS: --"
    
    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 6)
    Corner.Parent = FpsLabel

    local NotifLabel = Instance.new("TextLabel")
    NotifLabel.Name = "NotifLabel"
    NotifLabel.Parent = ScreenGui
    NotifLabel.Size = UDim2.new(0, 260, 0, 40)
    NotifLabel.Position = UDim2.new(0.5, -130, 1, 100)
    NotifLabel.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    NotifLabel.BackgroundTransparency = 0.15
    NotifLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    NotifLabel.TextSize = 15
    NotifLabel.Font = Enum.Font.SourceSansBold
    NotifLabel.Text = "XDM Hub - Fix Lag: Loading..."

    local NotifCorner = Instance.new("UICorner")
    NotifCorner.CornerRadius = UDim.new(0, 8)
    NotifCorner.Parent = NotifLabel

    local NotifStroke = Instance.new("UIStroke")
    NotifStroke.Color = Color3.fromRGB(0, 170, 255)
    NotifStroke.Thickness = 1.5
    NotifStroke.Parent = NotifLabel

    task.spawn(function()
        local frameCount = 0
        local lastCheck = tick()
        RunService.RenderStepped:Connect(function()
            frameCount = frameCount + 1
            local currentTime = tick()
            if currentTime - lastCheck >= 1 then
                FpsLabel.Text = "FPS: " .. tostring(math.floor(frameCount / (currentTime - lastCheck)))
                frameCount = 0
                lastCheck = currentTime
            end
        end)
    end)

    return NotifLabel
end

local notif = createUI()

local function showNotification(text)
    notif.Text = text
    TweenService:Create(notif, TweenInfo.new(0.4), {Position = UDim2.new(0.5, -130, 1, -60)}):Play()
    task.delay(4, function()
        TweenService:Create(notif, TweenInfo.new(0.4), {Position = UDim2.new(0.5, -130, 1, 100)}):Play()
    end)
end

showNotification("XDM Hub - Fix Lag: Loading...")

task.spawn(function()
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    Lighting.Brightness = 1
    
    for _, child in ipairs(Lighting:GetChildren()) do
        if child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Sky") or child:IsA("Clouds") or child:IsA("SunRaysEffect") or child:IsA("BloomEffect") or child:IsA("BlurEffect") or child:IsA("ColorCorrectionEffect") then
            child:Destroy()
        end
    end

    local NewSky = Instance.new("Sky")
    NewSky.Name = "XDMSky"
    NewSky.SkyboxBk = ""
    NewSky.SkyboxDn = ""
    NewSky.SkyboxFt = ""
    NewSky.SkyboxLf = ""
    NewSky.SkyboxRt = ""
    NewSky.SkyboxUp = ""
    NewSky.SunTextureId = ""
    NewSky.MoonTextureId = ""
    NewSky.StarCount = 0
    NewSky.Parent = Lighting

    pcall(function()
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
        if terrain then
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
            terrain.WaterTransparency = 1
        end
    end)

    local function isProtected(obj)
        if not obj then return false end
        if LocalPlayer.Character and obj:IsDescendantOf(LocalPlayer.Character) then
            return true
        end
        
        local name = obj.Name:lower()

        if name:find("frozen") or name:find("prehistoric") or name:find("kitsune") then
            return true
        end

        local current = obj.Parent
        while current and current ~= Workspace do
            local cName = current.Name:lower()
            if cName == "enemies" or cName == "npcs" or cName == "boats" or cName == "characters" then
                return true
            end
            if cName:find("frozen") or cName:find("prehistoric") or cName:find("kitsune") or cName:find("boat") or cName:find("ship") or cName:find("leviathan") or cName:find("seaevent") then
                return true
            end
            current = current.Parent
        end

        if Workspace:FindFirstChild("Enemies") and obj:IsDescendantOf(Workspace.Enemies) then return true end
        if Workspace:FindFirstChild("NPCs") and obj:IsDescendantOf(Workspace.NPCs) then return true end
        if Workspace:FindFirstChild("Boats") and obj:IsDescendantOf(Workspace.Boats) then return true end

        if name:find("boat") or name:find("ship") or name:find("leviathan") or name:find("seaevent") or name:find("npc") or name:find("enemy") then
            return true
        end

        if obj:FindFirstChildOfClass("Humanoid") then
            return true
        end

        return false
    end

    local function clearVFX(v)
        if isProtected(v) then return false end

        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Highlight") or v:IsA("SelectionBox") or v:IsA("Explosion") then
            pcall(function()
                v.Enabled = false
                v:Destroy()
            end)
            return true
        end

        if v:IsA("Light") or v:IsA("PostEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") then
            pcall(function() v:Destroy() end)
            return true
        end

        if v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance") then
            pcall(function() v:Destroy() end)
            return true
        end

        if v:IsA("MeshPart") or v:IsA("BasePart") then
            local name = v.Name:lower()
            if name:find("effect") or name:find("vfx") or name:find("skill") or name:find("aura") or name:find("slash") or name:find("blast") or name:find("hit") or name:find("particle") or name:find("ring") or name:find("flash") or name:find("beam") or name:find("magic") or name:find("circle") then
                pcall(function()
                    v.Transparency = 1
                    v:Destroy()
                end)
                return true
            end
        end

        return false
    end

    local function cleanMapObject(v)
        if isProtected(v) then return end
        if clearVFX(v) then return end

        if v:IsA("MeshPart") or v:IsA("BasePart") then
            local name = v.Name:lower()
            if name:find("water") or name:find("ocean") or name:find("sea") then
                v.Transparency = 1
            elseif name:find("ground") or name:find("floor") or name:find("base") or name:find("grass") or name:find("sand") or name:find("land") or name:find("terrain") then
                v.Material = Enum.Material.SmoothPlastic
                v.Color = Color3.fromRGB(80, 80, 80)
            else
                v.Transparency = 1
            end
        end
    end

    local allInstances = Workspace:GetDescendants()
    local count = 0
    for _, v in ipairs(allInstances) do
        pcall(cleanMapObject, v)
        count = count + 1
        if count % 120 == 0 then
            task.wait()
        end
    end

    Workspace.DescendantAdded:Connect(function(v)
        task.spawn(function()
            if isProtected(v) then return end
            clearVFX(v)
        end)
    end)

    local camera = Workspace.CurrentCamera
    if camera then
        camera.ChildAdded:Connect(function(child)
            task.spawn(function()
                clearVFX(child)
            end)
        end)
        for _, child in ipairs(camera:GetChildren()) do
            task.spawn(function()
                clearVFX(child)
            end)
        end
    end

    showNotification("XDM Hub - Fix Lag: Load Xong!")
end)
