local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

-- 1. Tối ưu Ánh sáng & Bầu trời (Xóa hiệu ứng màu màn hình)
Lighting.GlobalShadows = false
Lighting.FogEnd = 9e9
Lighting.Brightness = 1
Lighting.OutdoorAmbient = Color3.fromRGB(120, 120, 120)
Lighting.Ambient = Color3.fromRGB(120, 120, 120)

for _, v in ipairs(Lighting:GetChildren()) do
    if v:IsA("PostEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("Atmosphere") then
        pcall(function() v:Destroy() end)
    end
end

-- 2. Hàm dọn sạch Hiệu ứng Chiêu (VFX), Hạt sáng, Đèn, Decal
local function cleanVFX(v)
    if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Highlight") or v:IsA("SelectionBox") or v:IsA("Explosion") then
        pcall(function()
            v.Enabled = false
            v:Destroy()
        end)
    elseif v:IsA("Light") or v:IsA("PostEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BlurEffect") then
        pcall(function() v:Destroy() end)
    elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance") then
        pcall(function() v:Destroy() end)
    end
end

-- 3. Bỏ qua các đối tượng quan trọng mà Script Farm cần dùng
local function isEssential(obj)
    if not obj then return true end
    
    -- Bảo vệ Người chơi
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and (obj == p.Character or obj:IsDescendantOf(p.Character)) then
            return true
        end
    end
    
    -- Bảo vệ NPC, Quái, Quest, Thuyền, Cổng dịch chuyển
    local current = obj
    while current and current ~= Workspace do
        local name = current.Name:lower()
        if name:find("enemy") or name:find("enemies") or name:find("npc") or name:find("quest") or name:find("boat") or name:find("player") or name:find("location") or name:find("world") then
            return true
        end
        if current:FindFirstChildOfClass("Humanoid") or current:FindFirstChildOfClass("TouchTransmitter") then
            return true
        end
        current = current.Parent
    end
    
    return false
end

-- 4. Ẩn Map (Không Destroy để Script Farm vẫn Raycast/Teleport được)
local function optimizeObject(obj)
    cleanVFX(obj)
    
    if isEssential(obj) then return end

    if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation") then
        pcall(function()
            obj.Transparency = 1
            obj.CastShadow = false
            obj.Material = Enum.Material.SmoothPlastic
        end)
    end
end

-- Quét ẩn Map toàn bộ Workspace
for _, v in ipairs(Workspace:GetDescendants()) do
    task.spawn(optimizeObject, v)
end

-- Làm trong suốt nước biển
pcall(function()
    local terrain = Workspace.Terrain
    terrain.WaterTransparency = 1
    terrain.WaterWaveSize = 0
    terrain.WaterWaveSpeed = 0
    terrain.WaterReflectance = 0
end)

-- Tự động xóa VFX chiêu mới khi xài skill
Workspace.DescendantAdded:Connect(function(v)
    task.spawn(function()
        cleanVFX(v)
    end)
end)
