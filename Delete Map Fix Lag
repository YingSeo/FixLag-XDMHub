local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- 1. Tạo Sàn Xám Phẳng ngay dưới chân bạn để đứng cố định
local function createPlatform()
    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local spawnY = root and (root.Position.Y - 3.5) or 0
    local spawnPos = root and Vector3.new(root.Position.X, spawnY, root.Position.Z) or Vector3.new(0, 0, 0)

    local platform = Workspace:FindFirstChild("XDM_FarmPlatform")
    if not platform then
        platform = Instance.new("Part")
        platform.Name = "XDM_FarmPlatform"
        platform.Size = Vector3.new(100000, 10, 100000)
        platform.Position = spawnPos
        platform.Anchored = true
        platform.CanCollide = true
        platform.Material = Enum.Material.SmoothPlastic
        platform.Color = Color3.fromRGB(80, 80, 80)
        platform.Parent = Workspace
    end
    return platform
end

local platform = createPlatform()

-- 2. Tắt hiệu ứng Ánh sáng & Bầu trời (Xóa màu màn hình, tăng FPS)
Lighting.GlobalShadows = false
Lighting.FogEnd = 9e9
Lighting.Brightness = 1
Lighting.OutdoorAmbient = Color3.fromRGB(120, 120, 120)
Lighting.Ambient = Color3.fromRGB(120, 120, 120)

for _, v in ipairs(Lighting:GetChildren()) do
    if v:IsA("PostEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("Atmosphere") then
        pcall(function() v:Destroy() end)
    end
end

-- 3. Kiểm tra bảo vệ Nhân vật / NPC / Quái / Thuyền / Sàn
local function isProtected(obj)
    if not obj then return true end
    if obj == platform or obj.Name == "XDM_FarmPlatform" then return true end

    -- Bảo vệ Người chơi
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and (obj == p.Character or obj:IsDescendantOf(p.Character)) then
            return true
        end
    end

    -- Bảo vệ NPC, Quái, Quest, Thuyền
    local current = obj
    while current and current ~= Workspace do
        local name = current.Name:lower()
        if name:find("enemy") or name:find("enemies") or name:find("npc") or name:find("quest") or name:find("boat") or name:find("player") then
            return true
        end
        if current:FindFirstChildOfClass("Humanoid") then
            return true
        end
        current = current.Parent
    end

    return false
end

-- 4. Tắt VFX Chiêu, Hạt sáng, Đèn, Decal
local function cleanVFX(v)
    if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Highlight") or v:IsA("SelectionBox") or v:IsA("Explosion") then
        pcall(function()
            v.Enabled = false
            v:Destroy()
        end)
    elseif v:IsA("Light") or v:IsA("PostEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BlurEffect") then
        pcall(function() v:Destroy() end)
    elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance") then
        pcall(function() v:Destroy() end)
    end
end

-- 5. Làm tàng hình Map (Không xóa để Script Farm vẫn đọc được dữ liệu)
local function hideMap(obj)
    cleanVFX(obj)

    if isProtected(obj) then return end

    if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation") then
        pcall(function()
            obj.Transparency = 1
            obj.CastShadow = false
        end)
    end
end

-- Tiến hành tàng hình Map
task.spawn(function()
    for _, v in ipairs(Workspace:GetDescendants()) do
        hideMap(v)
    end
end)

-- Tắt nước biển
pcall(function()
    local terrain = Workspace.Terrain
    terrain.WaterTransparency = 1
    terrain.WaterWaveSize = 0
    terrain.WaterWaveSpeed = 0
    terrain.WaterReflectance = 0
end)

-- Tự động dọn dẹp VFX khi tung chiêu mới mà không làm treo game
Workspace.DescendantAdded:Connect(function(v)
    task.spawn(function()
        cleanVFX(v)
    end)
end)
