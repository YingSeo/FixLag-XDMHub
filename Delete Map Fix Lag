-- ============================================================
-- SECTION 4: FAST BULK DESTROY ENGINE
-- ============================================================
local destroyed = 0
local skipped   = 0

local function ShouldDestroy(obj)
    -- Không phá character player
    if IsPlayerCharacterPart(obj) then
        skipped = skipped + 1
        return false
    end

    -- Giữ tên exact
    if KEEP_NAME_EXACT[obj.Name] then
        skipped = skipped + 1
        return false
    end

    -- Giữ Camera và Terrain tuyệt đối
    local cls = obj.ClassName
    if cls == "Camera" or cls == "Terrain" then
        return false
    end

    -- Xóa theo class (particle, light, sound, beam, v.v.)
    if DESTROY_CLASS[cls] then
        return true
    end

    -- Xóa BasePart/MeshPart/Union khớp keyword
    if cls == "Part" or cls == "MeshPart" or cls == "UnionOperation"
    or cls == "WedgePart" or cls == "CornerWedgePart" or cls == "TrussPart" then
        local lname = string.lower(obj.Name)
        for _, kw in ipairs(DESTROY_NAME_KEYWORDS) do
            if lname:find(kw, 1, true) then
                return true
            end
        end
    end

    return false
end

-- CORE: GetDescendants một lần, lọc, destroy batch
local function BulkDestroy(parent)
    local all = parent:GetDescendants()
    local targets = {}

    -- Pass 1: thu thập target (không destroy ngay, tránh iterator lỗi)
    for i = 1, #all do
        local obj = all[i]
        if obj and obj.Parent ~= nil then
            if ShouldDestroy(obj) then
                targets[#targets + 1] = obj
            end
        end
    end

    -- Pass 2: destroy toàn bộ
    for i = 1, #targets do
        pcall(function()
            if targets[i] and targets[i].Parent then
                targets[i]:Destroy()
                destroyed = destroyed + 1
            end
        end)
    end

    return #targets
end

-- ============================================================
-- SECTION 5: XÓA TERRAIN EFFECTS (OCEAN WAVE NHƯ HÌNH)
-- ============================================================
local function NukeTerrain()
    pcall(function()
        local t = Workspace:FindFirstChildOfClass("Terrain")
        if not t then return end

        -- Xóa hoàn toàn hiệu ứng nước
        t.WaterWaveSize      = 0
        t.WaterWaveSpeed     = 0
        t.WaterReflectance   = 0
        t.WaterTransparency  = 1
        t.WaterColor         = Color3.fromRGB(0, 0, 0)

        -- Tắt cỏ, trang trí terrain
        t.Decoration         = false

        -- Xóa tất cả children của Terrain (texture overlay, v.v.)
        for _, child in ipairs(t:GetChildren()) do
            pcall(function() child:Destroy() end)
        end
    end)
end

-- ============================================================
-- SECTION 6: NUKE LIGHTING
-- ============================================================
local function NukeLighting()
    pcall(function()
        Lighting.GlobalShadows    = false
        Lighting.ShadowSoftness   = 0
        Lighting.Brightness       = 1
        Lighting.Ambient          = Color3.fromRGB(130,130,130)
        Lighting.OutdoorAmbient   = Color3.fromRGB(130,130,130)
        Lighting.FogEnd           = 999999
        Lighting.FogStart         = 999999
        Lighting.ClockTime        = 14  -- ban ngày, không cần bóng tối

        -- Xóa hết post-processing
        for _, fx in ipairs(Lighting:GetChildren()) do
            local c = fx.ClassName
            if c == "Atmosphere" or c == "BloomEffect" or c == "BlurEffect"
            or c == "ColorCorrectionEffect" or c == "SunRaysEffect"
            or c == "DepthOfFieldEffect" or c == "BlackAndWhiteEffect" then
                pcall(function() fx:Destroy() end)
            end
        end
    end)
end

