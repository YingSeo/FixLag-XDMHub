-- ============================================================
-- SECTION 10: GIẢM RENDER DISTANCE CHO PLAYER KHÁC
-- ============================================================
local function ReduceOtherPlayersDetail()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            for _, part in ipairs(p.Character:GetDescendants()) do
                if part:IsA("ParticleEmitter") or part:IsA("Trail")
                or part:IsA("BillboardGui") then
                    pcall(function() part.Enabled = false end)
                end
            end
        end
    end
end

-- ============================================================
-- SECTION 11: TỰ ĐỘNG DỌN KHI CÓ VẬT THỂ MỚI SPAWN
-- ============================================================
local function WatchNewObjects()
    Workspace.DescendantAdded:Connect(function(obj)
        -- Chờ 0.1s để object load xong
        task.delay(0.1, function()
            CleanObject(obj)
        end)
    end)
end

-- ============================================================
-- SECTION 12: CHẠY TẤT CẢ
-- ============================================================
local function Main()
    print("[MrDon] Bắt đầu tối ưu Blox Fruits...")

    -- Bước 1: Lighting
    OptimizeLighting()
    print("[MrDon] ✓ Lighting đã tối ưu")

    -- Bước 2: Terrain
    OptimizeTerrain()
    print("[MrDon] ✓ Terrain đã tối ưu")

    -- Bước 3: Quét và xóa object
    ScanWorkspace()
    print("[MrDon] ✓ Đã xóa " .. removed .. " object thừa")

    -- Bước 4: Giảm detail player khác
    ReduceOtherPlayersDetail()
    print("[MrDon] ✓ Đã tắt hiệu ứng player khác")

    -- Bước 5: FPS cap
    SetFPSCap(CONFIG.FPSLimit)
    print("[MrDon] ✓ FPS giới hạn: " .. CONFIG.FPSLimit)

    -- Bước 6: Theo dõi object mới
    WatchNewObjects()
    print("[MrDon] ✓ Watcher đang chạy nền")

    -- Bước 7: Thông báo xong
    Notify(
        "✅ MrDon FPS Boost",
        "Đã xóa " .. removed .. " object. FPS tối ưu!",
        5
    )

    print("[MrDon] === HOÀN TẤT ===")
end

-- Bảo vệ lỗi toàn cục
local ok, err = pcall(Main)
if not ok then
    warn("[MrDon] Lỗi: " .. tostring(err))
