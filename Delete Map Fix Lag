    "Dough King","Order","Cake Prince","Isle Priest",
    "Longma","Captain Elephant","Tiki Outpost Islander",
    -- Generic NPC types
    "NPC","Dealer","Trader","Instructor","Guard","Crew",
    "Pirate","Marine","Bandit","Mercenary","Fighter",
    "Master","Teacher","Selector","Shipwright","Prisoner",
    -- Functional NPC
    "Mysterious Scientist","Mad Scientist","Sick Man",
    "Hungry Man","Wealthy Citizen","Rich Man","Baby Yoda",
    "Military Detective","Horned Man","Zapdos","Chief",
    "Manager","Bartilo","Izuku","Saber Expert","Raid Boss",
}

local NPC_NAME_SET = {}
for _, n in ipairs(NPC_ROOT_NAMES) do
    NPC_NAME_SET[string.lower(n)] = true
end

local function IsNPCByName(model)
    if not model then return false end
    local lname = string.lower(model.Name)
    -- Check exact
    if NPC_NAME_SET[lname] then return true end
    -- Check partial (NPC, Dealer, etc.)
    for key, _ in pairs(NPC_NAME_SET) do
        if lname:find(key, 1, true) then return true end
    end
    return false
end

local function ShouldSkipRoot(root)
    -- Là player character
    for _, p in ipairs(Players:GetPlayers()) do
        if root == p.Character then return true end
    end
    -- Tên là NPC
    if IsNPCByName(root) then return true end
    -- Có Humanoid bên trong
    if root:IsA("Model") then
        if root:FindFirstChildWhichIsA("Humanoid", true) then
            return true
        end
    end
    return false
end

-- ============================================================
-- SECTION 3: DANH SÁCH MAP OBJECTS CẦN XÓA (TINH CHỈNH)
-- ============================================================
-- CHỈ xóa các object rõ ràng là trang trí/map
-- KHÔNG xóa theo keyword mơ hồ để tránh đụng NPC

-- Class xóa vô điều kiện (kể cả trong NPC - CHỈ visual effects)
local ALWAYS_DESTROY_CLASS = {
    ["ParticleEmitter"] = true,
    ["Trail"]           = true,
    ["Beam"]            = true,
    ["Smoke"]           = true,
    ["Fire"]            = true,
    ["Sparkles"]        = true,
    ["Atmosphere"]      = true,
    ["BloomEffect"]     = true,
    ["BlurEffect"]      = true,
    ["ColorCorrectionEffect"] = true,
    ["SunRaysEffect"]   = true,
    ["DepthOfFieldEffect"] = true,
}

-- Class xóa chỉ khi KHÔNG phải NPC/player
local MAP_DESTROY_CLASS = {
    ["PointLight"]      = true,
    ["SpotLight"]       = true,
    ["SurfaceLight"]    = true,
    ["Decal"]           = true,
    ["Texture"]         = true,
    ["BillboardGui"]    = true,  -- chỉ trên map, NPC đã skip
    ["SurfaceGui"]      = true,
    ["Sound"]           = true,
    ["SelectionBox"]    = true,
    ["Highlight"]       = true,
    ["SpecialMesh"]     = true,
}

-- Keyword xóa BasePart MAP (không phải NPC)
-- Tập trung vào buildings/pillars như hình: đen, cao, dạng cột
local MAP_PART_KEYWORDS = {
    -- Buildings / Structures thừa (như pillars đen trong hình)
    "pillar","column","beam_","railing","fence","post_",
    "wall_","floor_","ceiling","roof","stair","step_",
    "platform_deco","building_detail","prop_","decoration",
    "deco_","detail_","trim_","frame_","border_","edge_",
    "window_","door_frame","arch_","gate_","barricade",

    -- Ocean / water effects
    "wave","foam","splash","ripple","bubble","tide",
    "whirlpool","current_","waterdrop","spray",

    -- Thiên nhiên
    "tree_","bush_","grass_","flower_","leaf_","vine_",
    "plant_","fern_","shrub_","palm_","bamboo_","reed_",
    "moss_","ivy_","stump_","rock_deco","pebble_",
    "boulder_deco","cliff_deco","crystal_deco",

    -- Thời tiết particle
    "cloud_part","fog_part","mist_part","rain_drop",
    "snowflake","ash_","dust_",

    -- Đồ vật trang trí map
    "barrel_","crate_deco","lantern_","lamp_deco","torch_",
    "banner_","flag_","carpet_","cloth_","curtain_",
    "statue_","anchor_","rope_","hay_","straw_",
    "wreck_","ruin_","dock_deco","pier_deco",
    "ambient_","scenery_","backdrop_","filler_",
}

local function MatchesMapKeyword(name)
    local lname = string.lower(name)
    for _, kw in ipairs(MAP_PART_KEYWORDS) do
        if lname:find(kw, 1, true) then return true end
    end
    return false
end

-- ============================================================
-- SECTION 4: SMART DESTROY LOGIC
-- ============================================================
local destroyed = 0

local function SmartDestroy(obj)
    if not obj or not obj.Parent then return end

    local cls = obj.ClassName

    -- 1. Visual effects: xóa kể cả trong NPC (chỉ particle/trail/beam)
    --    NHƯNG không xóa nếu là player
    if ALWAYS_DESTROY_CLASS[cls] then
        if not IsPlayerPart(obj) then
            pcall(function()
                obj.Enabled = false  -- tắt trước
                obj:Destroy()
                destroyed = destroyed + 1
            end)
        end
        return
    end

    -- 2. Mọi thứ còn lại: KHÔNG đụng NPC hoặc player
    if IsPlayerPart(obj) then return end

    -- Tìm root model
    local root = GetRootModel(obj)
    if root and root:IsA("Model") and ShouldSkipRoot(root) then
        return  -- Bên trong NPC => bỏ qua
    end

    -- 3. Map-only class
    if MAP_DESTROY_CLASS[cls] then
        pcall(function()
            obj:Destroy()
            destroyed = destroyed + 1
        end)
        return
    end

    -- 4. BasePart/MeshPart theo keyword map
    if cls == "Part" or cls == "MeshPart" or cls == "UnionOperation"
    or cls == "WedgePart" or cls == "CornerWedgePart" or cls == "TrussPart" then
        if MatchesMapKeyword(obj.Name) then
            pcall(function()
                obj:Destroy()
                destroyed = destroyed + 1
            end)
        end
    end
end

-- ============================================================
-- SECTION 5: TERRAIN FIX (OCEAN NHƯ HÌNH)
-- ============================================================
local function NukeTerrain()
    pcall(function()
        local t = Workspace:FindFirstChildOfClass("Terrain")
        if not t then return end
        t.WaterWaveSize     = 0
        t.WaterWaveSpeed    = 0
        t.WaterReflectance  = 0
        t.WaterTransparency = 1
        t.WaterColor        = Color3.fromRGB(30, 80, 140)
        t.Decoration        = false
        print("[MrDon] ✓ Terrain water nuked")
    end)
end

-- ============================================================
-- SECTION 6: LIGHTING CLEAN
-- ============================================================
local function NukeLighting()
    pcall(function()
        Lighting.GlobalShadows  = false
        Lighting.ShadowSoftness = 0
        Lighting.Brightness     = 1
        Lighting.FogEnd         = 999999
        Lighting.FogStart       = 999999
        Lighting.Ambient        = Color3.fromRGB(128,128,128)
        Lighting.OutdoorAmbient = Color3.fromRGB(128,128,128)

        for _, fx in ipairs(Lighting:GetChildren()) do
            local c = fx.ClassName
            if c == "Atmosphere" or c == "BloomEffect" or c == "BlurEffect"
            or c == "ColorCorrectionEffect" or c == "SunRaysEffect"
            or c == "DepthOfFieldEffect" then
                pcall(function() fx:Destroy() end)
            end
        end
        print("[MrDon] ✓ Lighting cleaned")
    end)
end

