-- ============================================================
-- SECTION 8: MAIN SCAN - 2-PASS BULK
-- ============================================================
local function RunScan()
    -- Build NPC cache trước
    for _, root in ipairs(Workspace:GetChildren()) do
        if root:IsA("Model") then
            local has = root:FindFirstChildWhichIsA("Humanoid", true) ~= nil
            npcCache[tostring(root)] = has
        end
    end
    print("[MrDon] ✓ NPC cache built: " .. #Workspace:GetChildren() .. " roots scanned")

    -- GetDescendants 1 lần duy nhất
    local all = Workspace:GetDescendants()
    local targets = {}

    -- Pass 1: collect
    for i = 1, #all do
        local obj = all[i]
        if obj and obj.Parent then
            local cls = obj.ClassName

            -- Quick accept: particle effects (xóa mọi chỗ trừ player)
            if ALWAYS_DESTROY_CLASS[cls] and not IsPlayerPart(obj) then
                targets[#targets+1] = obj

            -- Map class: cần check NPC
            elseif MAP_DESTROY_CLASS[cls] and not IsPlayerPart(obj) then
                local root = GetRootModel(obj)
                if not (root and root:IsA("Model") and ShouldSkipRoot(root)) then
                    targets[#targets+1] = obj
                end

            -- BasePart keyword: cần check NPC
            elseif (cls=="Part" or cls=="MeshPart" or cls=="UnionOperation"
                 or cls=="WedgePart" or cls=="CornerWedgePart" or cls=="TrussPart")
                and not IsPlayerPart(obj)
                and MatchesMapKeyword(obj.Name) then

                local root = GetRootModel(obj)
                if not (root and root:IsA("Model") and ShouldSkipRoot(root)) then
                    targets[#targets+1] = obj
                end
            end
        end
    end

    print("[MrDon] ✓ Targets collected: " .. #targets)

    -- Pass 2: destroy bulk
    for i = 1, #targets do
        pcall(function()
            if targets[i] and targets[i].Parent then
                targets[i]:Destroy()
                destroyed = destroyed + 1
            end
        end)
    end

    print("[MrDon] ✓ Destroyed: " .. destroyed)
end

-- ============================================================
-- SECTION 9: WATCHER
-- ============================================================
local function StartWatcher()
    Workspace.DescendantAdded:Connect(function(obj)
        task.delay(0.1, function()
            if not obj or not obj.Parent then return end
            -- Reset cache khi có model mới (NPC mới spawn)
            local root = GetRootModel(obj)
            if root and root:IsA("Model") then
                npcCache[tostring(root)] = nil  -- force re-check
            end
            SmartDestroy(obj)
        end)
    end)
    print("[MrDon] ✓ Watcher active")
end

-- ============================================================
-- SECTION 10: EXECUTE
-- ============================================================
local ok, err = pcall(function()
    local t0 = tick()

    NukeLighting()
    NukeTerrain()
    RunScan()
    OptimizeRender()
    StartWatcher()

    local ms = math.floor((tick()-t0)*1000)
    print("[MrDon v4.0] === DONE | " .. destroyed .. " objects | " .. ms .. "ms ===")

    Notify(
        "✅ MrDon v4.0 DONE",
        "Xóa " .. destroyed .. " objects. NPC an toàn. FPS boost!",
        6
    )
end)

if not ok then
    warn("[MrDon] FATAL: " .. tostring(err))
    Notify("⚠️ Lỗi", tostring(err), 8)
end
