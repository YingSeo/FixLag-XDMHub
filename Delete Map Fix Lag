-- ============================================================
-- SECTION 8: AUTO-WATCHER (xóa object mới spawn)
-- ============================================================
local function StartWatcher()
    Workspace.DescendantAdded:Connect(function(obj)
        task.delay(0.05, function()  -- 50ms delay thay vì 100ms
            if obj and obj.Parent and ShouldDestroy(obj) then
                pcall(function()
                    obj:Destroy()
                    destroyed = destroyed + 1
                end)
            end
        end)
    end)
end

