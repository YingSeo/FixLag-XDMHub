local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- 1. Tạo Sàn Ngay Mặt Nước Biển (Tọa độ Y = 0)
local platform = Workspace:FindFirstChild("XDM_WaterPlatform")
if not platform then
    platform = Instance.new("Part")
    platform.Name = "XDM_WaterPlatform"
    platform.Size = Vector3.new(60000, 2, 60000)
    platform.Position = Vector3.new(0, -1, 0) -- Mặt trên sàn đúng Y = 0 (Mặt nước)
    platform.Anchored = true
    platform.CanCollide = true
    platform.Material = Enum.Material.SmoothPlastic
    platform.Transparency = 0.3 -- Hơi trong suốt nhẹ giống mặt nước
    platform.Color = Color3.fromRGB(0, 120, 200)
    platform.Parent = Workspace
end

-- 2. Tắt hiệu ứng ánh sáng & Bầu trời (Tăng FPS)
Lighting.GlobalShadows = false
Lighting.FogEnd = 9e9
Lighting.Brightness = 1
Lighting.OutdoorAmbient = Color3.fromRGB(120, 120, 120)
Lighting.Ambient = Color3.fromRGB(120, 120, 120)

for _, v in ipairs(Lighting:GetChildren()) do
    if v:IsA("PostEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("Atmosphere") then
        pcall(function() v:Destroy() end)
    end
end

-- 3. Nhận diện NPC / Quái / Player / Thuyền
local function isEntity(obj)
    if not obj then return false end
    if obj == platform or obj.Name == "XDM_WaterPlatform" then return true end

    -- Người chơi
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and (obj == p.Character or obj:IsDescendantOf(p.Character)) then
            return true
        end
    end

    -- NPC, Quái, Thuyền, Quest
    local model = obj:FindFirstAncestorOfClass("Model")
    if model then
        if model.Parent and (model.Parent.Name == "NPCs" or model.Parent.Name == "Enemies" or model.Parent.Name == "Characters") then
            return true
        end
        if model:FindFirstChildOfClass("Humanoid") or model:FindFirstChildOfClass("ProximityPrompt") or model:FindFirstChildOfClass("ClickDetector") then
            return true
        end
        local name = model.Name:lower()
        if name:find("npc") or name:find("quest") or name:find("enemy") or name:find("dealer") or name:find("gacha") or name:find("merchant") or name:find("blox") or name:find("boat") then
            return true
        end
    end

    return false
end

-- 4. Fix Nút Tương Tác NPC (Bấm ăn liền, không cần giữ)
local function fixNPCInteraction(v)
    if v:IsA("ProximityPrompt") then
        pcall(function()
            v.Enabled = true
            v.HoldDuration = 0
            v.RequiresLineOfSight = false
            v.MaxActivationDistance = 60
        end)
    elseif v:IsA("ClickDetector") then
        pcall(function()
            v.MaxActivationDistance = 60
        end)
    end
end

-- 5. Xử lý Tàng Hình Map & Hiện Rõ NPC
local function processObject(v)
    if v:IsA("ProximityPrompt") or v:IsA("ClickDetector") then
        fixNPCInteraction(v)
        return
    end

    -- NẾU LÀ NPC / QUÁI / PLAYER -> HIỆN RÕ NGUYÊN BẢN
    if isEntity(v) then
        if v:IsA("BasePart") then
            pcall(function()
                v.Transparency = 0
                v.CanTouch = true
                v.CanQuery = true
            end)
        end
        return
    end

    -- XÓA VFX CHIÊU / HIỆU ỨNG RÁC
    if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Highlight") or v:IsA("SelectionBox") or v:IsA("Explosion") then
        pcall(function()
            v.Enabled = false
            v:Destroy()
        end)
    elseif v:IsA("Light") or v:IsA("PostEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BlurEffect") then
        pcall(function() v:Destroy() end)
    -- TÀNG HÌNH MAP (NÚI ĐÁ, NHÀ CỬA, CÂY CỐI)
    elseif v:IsA("BasePart") or v:IsA("MeshPart") or v:IsA("UnionOperation") then
        pcall(function()
            v.Transparency = 1
            v.CastShadow = false
        end)
    end
end

-- Quét toàn bộ Map
task.spawn(function()
    for _, v in ipairs(Workspace:GetDescendants()) do
        processObject(v)
    end
end)

-- Tự động quét vật thể mới xuất hiện
Workspace.DescendantAdded:Connect(function(v)
    task.spawn(function()
        processObject(v)
    end)
end)

-- Vòng lặp giữ cho nút bấm NPC luôn sẵn sàng
RunService.Heartbeat:Connect(function()
    for _, prompt in ipairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            prompt.Enabled = true
            prompt.HoldDuration = 0
            prompt.RequiresLineOfSight = false
        end
    end
end)
