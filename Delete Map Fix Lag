local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- 1. Tạo Sàn An Toàn Trên Không (Y = 100)
local platform = Workspace:FindFirstChild("XDM_SafePlatform")
if not platform then
    platform = Instance.new("Part")
    platform.Name = "XDM_SafePlatform"
    platform.Size = Vector3.new(20000, 20, 20000)
    platform.Position = Vector3.new(0, 100, 0) -- Đặt cao hẳn trên mặt nước
    platform.Anchored = true
    platform.CanCollide = true
    platform.Material = Enum.Material.SmoothPlastic
    platform.Color = Color3.fromRGB(80, 80, 80)
    platform.Parent = Workspace
end

-- 2. Tự động Giải cứu Nhân vật khi bị rơi xuống biển
local function rescuePlayer()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local hrp = char.HumanoidRootPart
        -- Nếu bị rớt xuống dưới biển (Y < 20), kéo ngay lên sàn an toàn
        if hrp.Position.Y < 20 then
            hrp.CFrame = CFrame.new(0, 115, 0)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end
    end
end

-- 3. Tắt Màu Màn Hình & Ánh Sáng (Tăng FPS)
Lighting.GlobalShadows = false
Lighting.FogEnd = 9e9
Lighting.Brightness = 1
Lighting.OutdoorAmbient = Color3.fromRGB(120, 120, 120)
Lighting.Ambient = Color3.fromRGB(120, 120, 120)

for _, v in ipairs(Lighting:GetChildren()) do
    if v:IsA("PostEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BlurEffect") or v:IsA("SunRaysEffect") or v:IsA("BloomEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("Atmosphere") then
        pcall(function() v:Destroy() end)
    end
end

-- 4. Xóa Hiệu ứng Chiêu (VFX) / Hạt sáng / Khói
local function disableVFX(v)
    if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Highlight") or v:IsA("SelectionBox") or v:IsA("Explosion") then
        pcall(function()
            v.Enabled = false
            v:Destroy()
        end)
    elseif v:IsA("Light") or v:IsA("PostEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("BlurEffect") then
        pcall(function() v:Destroy() end)
    elseif v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance") then
        pcall(function() v:Destroy() end)
    end
end

-- 5. Tàng hình Map (Không xóa Folder để Script Farm hoạt động)
local function hideMapPart(v)
    disableVFX(v)
    
    if v == platform or v.Name == "XDM_SafePlatform" then return end
    
    -- Bảo vệ người chơi và NPC/Quái/Thuyền
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character and v:IsDescendantOf(p.Character) then
            return
        end
    end
    
    local name = v.Name:lower()
    if name:find("enemy") or name:find("npc") or name:find("quest") or name:find("boat") or name:find("player") then
        return
    end
    
    if v:IsA("BasePart") or v:IsA("MeshPart") or v:IsA("UnionOperation") then
        pcall(function()
            v.Transparency = 1
            v.CastShadow = false
        end)
    end
end

-- Quét ẩn Map
task.spawn(function()
    for _, v in ipairs(Workspace:GetDescendants()) do
        hideMapPart(v)
    end
end)

-- Tự động dọn dẹp VFX khi tung chiêu mới
Workspace.DescendantAdded:Connect(function(v)
    task.spawn(function()
        disableVFX(v)
    end)
end)

-- Vòng lặp liên tục kiểm tra chống rơi biển
RunService.Heartbeat:Connect(function()
    rescuePlayer()
end)
