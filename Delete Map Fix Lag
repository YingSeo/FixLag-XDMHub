local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

-- 1. Tạo nền xám phẳng duy nhất để đứng
local baseplate = Workspace:FindFirstChild("XDM_Baseplate")
if not baseplate then
    baseplate = Instance.new("Part")
    baseplate.Name = "XDM_Baseplate"
    baseplate.Size = Vector3.new(500000, 10, 500000)
    baseplate.Position = Vector3.new(0, -10, 0)
    baseplate.Anchored = true
    baseplate.CanCollide = true
    baseplate.Material = Enum.Material.SmoothPlastic
    baseplate.Color = Color3.fromRGB(70, 70, 70)
    baseplate.Parent = Workspace
end

-- 2. Xóa sạch nước biển và địa hình (Terrain)
pcall(function()
    Workspace.Terrain:Clear()
end)

-- 3. Kiểm tra xem đối tượng có phải là Nhân vật / Quái / NPC / Thuyền không
local function isEntity(obj)
    if not obj then return false end
    if obj == baseplate then return true end
    
    -- Giữ lại người chơi
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character and obj:IsDescendantOf(player.Character) then
            return true
        end
    end
    
    -- Giữ lại Quái, NPC, Thuyền trong Blox Fruits
    local enemies = Workspace:FindFirstChild("Enemies")
    if enemies and obj:IsDescendantOf(enemies) then return true end
    
    local npcs = Workspace:FindFirstChild("NPCs")
    if npcs and obj:IsDescendantOf(npcs) then return true end
    
    local boats = Workspace:FindFirstChild("Boats")
    if boats and obj:IsDescendantOf(boats) then return true end

    if obj:FindFirstChildOfClass("Humanoid") then return true end
    
    return false
end

-- 4. Xóa sạch mọi hiệu ứng kỹ năng, hạt, ánh sáng & màu sắc
local function wipeVFXAndColors(obj)
    if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Highlight") or obj:IsA("SelectionBox") or obj:IsA("Explosion") then
        pcall(function()
            obj.Enabled = false
            obj:Destroy()
        end)
    elseif obj:IsA("Light") or obj:IsA("PostEffect") or obj:IsA("ColorCorrectionEffect") or obj:IsA("BlurEffect") or obj:IsA("SunRaysEffect") or obj:IsA("BloomEffect") or obj:IsA("DepthOfFieldEffect") then
        pcall(function() obj:Destroy() end)
    elseif obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("SurfaceAppearance") then
        pcall(function() obj:Destroy() end)
    end
end

-- 5. Xóa triệt để các phần của Map
local function purgeObject(obj)
    if isEntity(obj) then
        -- Nếu là entity, vẫn xóa các hiệu ứng chiêu gắn trên người/chiêu thức
        for _, child in ipairs(obj:GetDescendants()) do
            wipeVFXAndColors(child)
        end
        return
    end

    wipeVFXAndColors(obj)

    -- Xóa các Model/Part thuộc về Map
    if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation") or obj:IsA("Model") or obj:IsA("Folder") then
        if obj ~= Workspace.Terrain and obj ~= baseplate then
            pcall(function() obj:Destroy() end)
        end
    end
end

-- Quét toàn bộ Workspace hiện tại
for _, child in ipairs(Workspace:GetChildren()) do
    if not isEntity(child) and child ~= baseplate and child ~= Workspace.Terrain then
        pcall(function() child:Destroy() end)
    end
end

-- Tối ưu Lighting & Bầu trời (Xóa sạch màu sắc & hiệu ứng thời tiết)
Lighting.GlobalShadows = false
Lighting.FogEnd = 9e9
Lighting.Brightness = 1
Lighting.OutdoorAmbient = Color3.fromRGB(120, 120, 120)
Lighting.Ambient = Color3.fromRGB(120, 120, 120)

for _, child in ipairs(Lighting:GetChildren()) do
    pcall(function() child:Destroy() end)
end

local DarkSky = Instance.new("Sky")
DarkSky.Name = "PurgedSky"
DarkSky.SkyboxBk = ""
DarkSky.SkyboxDn = ""
DarkSky.SkyboxFt = ""
DarkSky.SkyboxLf = ""
DarkSky.SkyboxRt = ""
DarkSky.SkyboxUp = ""
DarkSky.SunTextureId = ""
DarkSky.MoonTextureId = ""
DarkSky.StarCount = 0
DarkSky.Parent = Lighting

-- 6. Lắng nghe liên tục khi Map hoặc Chiêu thức mới load ra
Workspace.DescendantAdded:Connect(function(obj)
    task.spawn(function()
        if isEntity(obj) then
            wipeVFXAndColors(obj)
        else
            purgeObject(obj)
        end
    end)
end)

-- Vòng lặp dọn dẹp liên tục (Chống Blox Fruits tự spawn lại Map & Nước)
RunService.Heartbeat:Connect(function()
    pcall(function() Workspace.Terrain:Clear() end)
    
    local mapFolder = Workspace:FindFirstChild("Map")
    if mapFolder then pcall(function() mapFolder:Destroy() end) end
    
    local locationsFolder = Workspace:FindFirstChild("Locations")
    if locationsFolder then pcall(function() locationsFolder:Destroy() end) end
end)
